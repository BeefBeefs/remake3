{
  "name": "nightstone-remake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript / three.js web remake of NightStone (2001, New Horizon Studios / Virgin Interactive)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "extract": "python3 tools/extract_nst.py",
    "convert": "python3 tools/convert_assets.py"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
